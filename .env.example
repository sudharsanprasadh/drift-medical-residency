# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your-supabase-project-url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Fitbit sync via Google Health API (legacy api.fitbit.com is deprecated).
# Must be a native/"Desktop app" Google OAuth client, separate from any
# Web-application credentials. Google requires client_secret on every token
# request even for this client type — its own docs say that's OK to embed
# in an installed app (unlike a Web-application secret).
EXPO_PUBLIC_GOOGLE_HEALTH_CLIENT_ID=your-google-oauth-client-id
EXPO_PUBLIC_GOOGLE_HEALTH_CLIENT_SECRET=your-google-oauth-client-secret
